# Copy this file to .env and fill in your own keys.
# .env itself must never be committed (it is in .gitignore).

# Alpaca: paper and live accounts have different keys. Paper keys only work
# without --live, live keys only work with --live.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# SEC EDGAR requires a User-Agent with a contact email for 13F downloads.
SEC_USER_AGENT="StockTrader you@example.com"

# LLM provider keys. A provider can have several keys, separated by commas;
# the agent rotates to the next one on 429/5xx.
# The variable names must match "api_key_env" in models.json.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
