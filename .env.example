# Copy this file to .env and fill in your own API keys.
# .env itself must never be committed (it is in .gitignore).

# A provider can have several keys, separated by commas; the agent rotates
# to the next one when a request is rate limited (429) or fails (5xx).
# The variable names must match "api_key_env" in models.json.
OPENROUTER_API_KEY=key1,key2
GOOGLE_API_KEY=
